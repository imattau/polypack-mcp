      "src": "https://raw.githubusercontent.com/imattau/polypack-mcp/master/docs/assets/logo-mark.svg",
      "mimeType": "image/svg+xml",
      "theme": "light"
    },
    {
      "src": "https://raw.githubusercontent.com/imattau/polypack-mcp/master/docs/assets/logo-mark-dark.svg",
      "mimeType": "image/svg+xml",
      "theme": "dark"
    }
  ],
  "version": "0.1.14",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "polypack-mcp",
      "version": "0.1.14",
